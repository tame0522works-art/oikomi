{
  "name": "oikomi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "縦書きの段の禁則を、追い込み・追い出し・ぶら下げで直すパズル",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "tsx tools/check-engine.ts && tsx tools/check-puzzles.ts && tsx tools/check-hints.ts",
    "check:engine": "tsx tools/check-engine.ts",
    "check:puzzles": "tsx tools/check-puzzles.ts",
    "glyphs": "tsx tools/glyphs.ts",
    "e2e": "vite build --outDir dist-e2e --emptyOutDir && tsx tools/e2e.ts",
    "screenshots": "tsx tools/screenshots.ts",
    "check:hints": "tsx tools/check-hints.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
